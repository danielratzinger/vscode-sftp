    "configuration": {
      "type": "object",
      "title": "sftp configuration",
      "properties": {
        "sftp.printDebugLog": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The older name for `#sftp.debug#`. Either one turns the same lines on; this is kept so configurations that set it keep working.",
          "markdownDeprecationMessage": "Use `#sftp.debug#` instead. Both do the same thing."
        },
        "sftp.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Write the verbose lines to the SFTP output channel: every protocol step of a connection, each file a walk looks at, what a credential command was asked. Useful when a connection fails in a way the error alone does not explain. It takes effect immediately - no reload - which matters, because the moment anyone turns this on is a moment something is already going wrong."
        },
        "sftp.passwordManager": {
          "type": [
            "string",
            "boolean"
          ],
          "default": true,
          "markdownDescription": "Where passwords live, for connections that set no `passwordManager` of their own. Takes the same values: `true` for the OS credential store (the Keychain on macOS), `false` to be asked every time, or a manager name such as `keychain`, `vscode`, `secret-tool`, `1password`, `pass`, `gopass` or `bitwarden`.(reload vscode when change this)"
        },
        "sftp.passphraseManager": {
          "type": [
            "string",
            "boolean"
          ],
          "default": true,
          "markdownDescription": "Where private key passphrases live, for connections that set no `passphraseManager` of their own. Same values as `#sftp.passwordManager#`.(reload vscode when change this)"
        },
        "sftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "\"Download\" instead of \"View Content\" when open file in Remote Explorer"
        },
        "sftp.downloadScripts.excludeExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "`Download Scripts` takes every file except these. An entry is an extension (`png`, `.png` and `*.png` all work) or a whole file name (`Thumbs.db`). Leave empty for the built-in list, which covers images, media, fonts, archives, binaries and office documents."
        },
        "sftp.downloadScripts.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders `Download Scripts` does not go into, matched by name at any depth. Empty by default, so every folder is walked. A common list is `[\"node_modules\", \"vendor\", \".git\", \"dist\", \"build\", \"__pycache__\"]`. The folder you ask for directly is always downloaded, even if it is named here."
        },
        "sftp.downloadWhenLocalIsNewer": {
          "type": "string",
          "enum": [
            "ask",
            "download",
            "skip"
          ],
          "enumDescriptions": [
            "Ask before replacing a local file that is newer than the one on the server.",
            "Download anyway, without checking. This is how downloads behaved before.",
            "Leave the local file alone and note it in the SFTP output channel."
          ],
          "default": "ask",
          "markdownDescription": "What to do when downloading a single file would replace a local copy whose timestamp is newer than the server’s. `Download` in the Alt menu always downloads, whatever this says. While the connection is autosynced from another folder, a download that would change the local file always asks, whichever copy is newer."
        },
        "sftp.upgradePlainFtp": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask a plain FTP server whether it accepts FTPS, and use it when it does. Many hosts accept TLS without anyone configuring it, and the alternative is a password sent as readable text. The certificate is not verified on an upgraded connection — set `\"secure\": true` in `sftp.json` for that. The answer is remembered per server for a week."
        },
        "sftp.warnOnCleartextPassword": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before connecting to a server that would receive the password as readable text. Plain FTP sends `USER` and `PASS` unencrypted; SFTP and FTPS (`secure`) do not, and are never warned about. The answer can be kept per server."
        },
        "sftp.keepReplacedFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep a copy of a local file before a download writes over it, when it differs from what is arriving. VS Code's own local history does not record downloads, so this is the only trace of what was there. Restore one with `SFTP: Restore File Replaced by a Download`."
        },
        "sftp.keepReplacedFilesPerFile": {
          "type": "number",
          "default": 5,
          "markdownDescription": "How many replaced copies of one file to keep."
        },
        "sftp.keepReplacedFilesDays": {
          "type": "number",
          "default": 30,
          "markdownDescription": "How long to keep a replaced copy, in days."
        },
        "sftp.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run a local MCP server so an AI client (Claude Desktop and others) can read the files on your configured servers. Listens on loopback only. Read-only with respect to the remote — it never writes to your servers, though it does write to disk locally. Run `SFTP: Show MCP Connection Details` to connect a client."
        },
        "sftp.mcp.exposed": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether connections are offered to MCP clients when they do not set `mcp.exposed` themselves. Only connections open in the editor are ever offered."
        },
        "sftp.mcp.port": {
          "type": "number",
          "default": 7391,
          "markdownDescription": "Port for the MCP server. The first VS Code window to take it serves; the rest stand by and take over if it closes. If another program already has it, a free port is used instead — stdio clients do not care, since the bridge discovers it."
        },
        "sftp.hostVerification": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check the SSH host key before sending anything to a server. The first connection to a host shows its fingerprint and asks once; a key that has *changed* is refused, with the old and new fingerprints shown and the option to update the stored one. Keys already in your `~/.ssh/known_hosts` are trusted without asking, and `StrictHostKeyChecking` / `UserKnownHostsFile` in your ssh config are honoured. Turn it off here for everything, or set `\"hostVerification\": false` on one connection in `sftp.json`."
        },
        "sftp.autosync.settleSeconds": {
          "type": "number",
          "default": 3,
          "markdownDescription": "How long a file must sit still before autosync uploads it. A build step writes a hundred files in a second, and a tool that writes without an atomic rename leaves a half-written one visible in between; waiting batches the first and avoids the second."
        },
        "sftp.autosync.retrySeconds": {
          "type": "number",
          "default": 5,
          "markdownDescription": "How long autosync waits before retrying a file that failed to upload. The wait grows with each further failure, up to five minutes, so a server that is briefly refusing is waited out rather than hammered. Nothing is dropped: whatever is still waiting when the window closes is picked up when it opens again."
        },
        "sftp.autosync.backupRemote": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Before autosync first writes over a file in a session, fetch what the server has and keep it - one copy per file per session, which is what makes `SFTP: Restore Server to an Earlier Point` possible. If the server cannot be reached to make the copy the file is **not** overwritten; it is retried instead. Turn this off to skip the extra fetch, at the cost of having no way back."
        },
        "sftp.autosync.backupDays": {
          "type": "number",
          "default": 30,
          "markdownDescription": "How long copies of the server's files are kept before they are swept. Whole sessions are removed, never single files out of one, so a session you can still see is one that can be restored in full. Swept when the editor starts and whenever autosync begins."
        },
        "sftp.autosync.backupMaxMB": {
          "type": "number",
          "default": 20,
          "markdownDescription": "The largest file whose server-side copy autosync will keep before overwriting it. The copy is held in memory on its way to disk, so a database dump or a video would take the window with it. Anything larger is uploaded anyway, with a line in the log saying there is no way back for that file."
        },
        "sftp.autosync.showEveryCheckout": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Offer every checkout git reports, including the ones nobody deploys. Two are left out by default: a worktree checked out at a commit rather than a branch, since nothing tracks it - there is no branch to keep the server on and no git catch-up to offer; and a worktree nested inside another checkout's `.git`, `.vscode` or `.claude`, since the thing deployed there is the checkout around it, which is why those folders are never uploaded. Agent tooling leaves a lot of both behind. The folder this window has open is always offered whatever state it is in."
        },
        "sftp.autosync.searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra folders to search for other checkouts of a project when picking one to autosync from. The folder holding the project is always searched; add paths here when your tooling clones elsewhere, for example `~/intent/workspaces`. Searched three levels deep, and only when you open the list."
        },
        "sftp.mcp.deniedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra file names never served to an MCP client, on top of the built-in list (`.env*`, `wp-config.php`, `.htpasswd`, `.npmrc`, `.pypirc`, `.my.cnf`, `kubeconfig`, `secrets.yml`, `*.tfvars`, private keys and similar). No value from a denied file is ever served or written to this machine. Where its names can be told from its values with certainty - an env file, a JSON credentials file - the names alone are served, so an agent can see which settings exist without seeing one of them. Anything else is refused outright."
        },
        "sftp.mcp.redactAssignments": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also replace credentials assigned to a name, such as `define('DB_PASSWORD', '…')` or `$cfg['pw'] = '…'`, on top of the recognisable key formats. References such as `env('DB_PASSWORD')` and validation rules are left alone. Turn this off if it takes out code you need."
        },
        "sftp.mcp.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders `search` does not walk into, by name at any depth. Empty by default. A common list is `[\"node_modules\", \"vendor\", \".git\", \"dist\"]`."
        },
        "sftp.mcp.exposeHistory": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let MCP clients read VS Code's local history for files in the project, through `history` and `diff`. It is the only record of how your working copy got to its current state. Read only, and already off when `workbench.localHistory.enabled` is false."
        },
        "sftp.mcp.callTimeout": {
          "type": "number",
          "default": 120000,
          "markdownDescription": "The ceiling on one MCP tool call, in milliseconds. A search or a tree walk that runs out of time stops and returns what it found, saying it was cut short; anything else is stopped with an error telling the model to ask for less. Set to 0 to let a call take as long as it takes."
        },
        "sftp.mcp.maxFileBytes": {
          "type": "number",
          "default": 2097152,
          "markdownDescription": "The largest file an MCP client may read, in bytes. Two megabytes by default. Bigger files are refused before they are fetched, and skipped during a search: they are almost always logs, dumps or media rather than code."
        },
        "sftp.mcp.maxFiles": {
          "type": "number",
          "default": 2000,
          "markdownDescription": "How many files one search may gather before it stops and says so."
        },
        "sftp.mcp.maxDepth": {
          "type": "number",
          "default": 8,
          "markdownDescription": "How many directory levels a walk may list, counting the starting directory as the first: `1` lists only what is in it and goes no further. The `tree` tool's own `depth` cannot exceed this. Each directory listed is one round trip."
        }
      }
    },
